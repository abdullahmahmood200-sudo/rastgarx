---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import FooterCompact from '../components/FooterCompact.astro';
import { absolute, breadcrumbSchema, graph } from '../data/schema';

// Reels and brand kit pages live in public/work/marketing/.
const base = '/work/marketing';

const reels = [
  { name: 'From scroll to sale', category: 'E-commerce explainer', file: 'loxvo-scroll-to-sale' },
  { name: 'The drop', category: '3D product hook', file: 'loxvo-the-drop' },
  { name: 'Milk at the back', category: 'Animated story', file: 'loxvo-milk-explainer' },
  { name: 'CRM on autopilot', category: 'AI automation ad', file: 'loxvo-crm-autopilot' },
];

// Meta Ads results, read from each client's Ads Manager (last 30 days).
const campaigns = [
  {
    name: 'Tradelle',
    category: 'Meta Ads',
    period: '22 Oct – 20 Nov 2026',
    shot: 'tradelle-ads-manager',
    body: 'Sales campaigns for Tradelle across three Meta campaigns: two sales campaigns running on daily budgets of Rs2,000 and Rs2,500, plus a conversions campaign. Close to 400,000 impressions turned into 212 sales in one month.',
    stats: [
      { value: '212', label: 'Sales' },
      { value: 'Rs558', label: 'Avg. cost per sale' },
      { value: '399,600', label: 'Impressions' },
      { value: 'Rs143,974', label: 'Ad spend' },
    ],
  },
  {
    name: 'Travel Souq',
    category: 'Travel · Meta Ads',
    period: '27 Oct – 25 Nov 2026',
    shot: 'travel-souq-ads-manager',
    body: 'A lean test for Travel Souq with an instant lead form and a click-to-message campaign side by side. Messaging won on cost, bringing in conversations at about a third of the price of a form lead.',
    stats: [
      { value: '10', label: 'Leads & conversations' },
      { value: 'Rs21', label: 'Per messaging conversation' },
      { value: 'Rs61', label: 'Per form lead' },
      { value: '1,159', label: 'Impressions' },
    ],
  },
];

const kits = [
  {
    name: 'Loxvo',
    category: 'E-commerce technology',
    body: 'A full identity for Loxvo, an e-commerce technology and AI consulting firm: an infinity-loop mark, a white, black and blue palette, typography, voice and real applications.',
    pages: ['loxvo-1', 'loxvo-2', 'loxvo-3', 'loxvo-4'],
    labels: ['Cover', 'Logo versions', 'Colour palette', 'Applications'],
    shape: 'wide',
  },
  {
    name: 'Gainslab',
    category: 'Fitness',
    body: 'A bold red, black and white identity for a fitness brand, with a custom wordmark, typography and gym applications.',
    pages: ['gainslab-1', 'gainslab-2', 'gainslab-3'],
    labels: ['Colour palette', 'Logo variations', 'Applications'],
    shape: 'wide',
  },
];

const jsonLd = graph(
  {
    '@type': 'CollectionPage',
    url: absolute('/marketing', Astro.site),
    name: 'Performance marketing portfolio: reels, ads and brand kits',
    provider: { '@id': absolute('/#business', Astro.site) },
    about: { '@type': 'Service', name: 'Performance marketing', provider: { '@id': absolute('/#business', Astro.site) } },
    mainEntity: {
      '@type': 'ItemList',
      itemListElement: [...campaigns.map((c) => `${c.name} Meta Ads case study`), ...reels.map((r) => `${r.name} (${r.category} reel)`), ...kits.map((k) => `${k.name} brand kit`)].map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })),
    },
  },
  breadcrumbSchema(Astro.site, [{ name: 'Home', path: '/' }, { name: 'Performance marketing', path: '/marketing' }]),
);

const links = [
  { href: '/work', label: 'WORK', current: true },
  { href: '/#solution', label: 'STUDIO' },
  { href: '/blog', label: 'BLOG' },
  { href: '/break-even-roas', label: 'ROAS TOOL' },
  { href: '/contact', label: 'CONTACT' },
];
---
<Base title="Performance Marketing Portfolio: Results, Reels & Brand Kits | RastgarX" description="Meta Ads case studies, short-form video ads, reels and brand identity kits made by RastgarX, a growth partner for businesses in Pakistan, for travel, e-commerce and fitness brands.">
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <div id="top" class="page">
    <div class="wrap">
      <Header links={links} homeHref="/" bookHref="/#book" />
      <div class="rule"></div>

      <main>
        <section class="animated-web">
          <div class="animated-web-head">
            <div>
              <p class="eyebrow">(Performance marketing)</p>
              <h1 class="display">Made to stop the scroll<span class="dot">.</span></h1>
            </div>
            <p class="lede">Meta ad campaigns, short-form video ads, reels and brand identities for travel, e-commerce and fitness brands, built to be noticed in the first second and remembered after.</p>
          </div>

          <div class="mk-block">
            <h2 class="mk-h2">Campaign results<span class="dot">.</span></h2>
            {campaigns.map((c) => (
              <article class="mk-kit">
                <div class="mk-kit-head">
                  <span class="auto-title"><span class="aw-name">{c.name}</span><span class="work-cat">({c.category})</span></span>
                  <p class="auto-body muted">{c.body}</p>
                </div>
                <dl class="mk-stats">
                  {c.stats.map((st) => (
                    <div class="mk-stat">
                      <dt class="work-cat">{st.label}</dt>
                      <dd>{st.value}</dd>
                    </div>
                  ))}
                </dl>
                <figure class="mk-shot">
                  <img src={`${base}/${c.shot}.webp`} alt={`Meta Ads Manager results for ${c.name}, last 30 days, ${c.period}`} loading="lazy" decoding="async" />
                  <figcaption class="work-cat">Last 30 days, {c.period}. Screenshot from Meta Ads Manager.</figcaption>
                </figure>
              </article>
            ))}
          </div>

          <div class="mk-block">
            <h2 class="mk-h2">Reels &amp; video ads<span class="dot">.</span></h2>
            <div class="mk-reels">
              {reels.map((r) => (
                <figure class="aw-item">
                  <div class="mk-reel">
                    <video data-mk-video src={`${base}/${r.file}.mp4`} poster={`${base}/${r.file}-poster.jpg`} muted loop playsinline preload="none" aria-label={`${r.name}, ${r.category.toLowerCase()} reel`}></video>
                  </div>
                  <figcaption class="mk-cap"><span class="mk-name">{r.name}</span><span class="work-cat">({r.category})</span></figcaption>
                </figure>
              ))}
            </div>
          </div>

          <div class="mk-block">
            <h2 class="mk-h2">Brand kits<span class="dot">.</span></h2>
            {kits.map((k) => (
              <article class="mk-kit">
                <div class="mk-kit-head">
                  <span class="auto-title"><span class="aw-name">{k.name}</span><span class="work-cat">({k.category})</span></span>
                  <p class="auto-body muted">{k.body}</p>
                </div>
                <div class:list={['mk-pages', `is-${k.shape}`]} style={`--cols:${k.pages.length}`}>
                  {k.pages.map((p, i) => (
                    <figure class="mk-page">
                      <img src={`${base}/${p}.webp`} alt={`${k.name} brand kit, ${k.labels[i].toLowerCase()}`} loading="lazy" decoding="async" />
                      <figcaption class="work-cat">{k.labels[i]}</figcaption>
                    </figure>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </section>

        <section class="work-cta center-section">
          <span class="tag">WORK WITH US</span>
          <h2 class="h-center">Want content people stop for<span class="dot">?</span></h2>
          <a class="cta" href="/#book">BOOK A FREE CALL</a>
        </section>
      </main>
    </div>
    <FooterCompact />
  </div>
</Base>

<script>
  // Play each reel only while it is on screen; reduced-motion visitors keep the poster.
  const videos = document.querySelectorAll<HTMLVideoElement>('[data-mk-video]');
  if (videos.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      });
    }, { threshold: 0.25 });
    videos.forEach((video) => observer.observe(video));
  }
</script>
