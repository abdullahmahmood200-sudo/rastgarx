---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import FooterCompact from '../components/FooterCompact.astro';
import Arrow from '../components/Arrow.astro';
import { absolute, breadcrumbSchema, graph } from '../data/schema';

// Break-even ROAS calculator. Defaults match the break-even ROAS reel:
// Rs 4,000 order, product 1,600, delivery + COD 400, returns + fees 560, 4x ROAS -> 36% margin, break-even 2.8x.
const links = [
  { href: '/#work', label: 'WORK' },
  { href: '/#solution', label: 'STUDIO' },
  { href: '/careers', label: 'CAREERS' },
  { href: '/break-even-roas', label: 'ROAS TOOL', current: true },
  { href: '/contact', label: 'CONTACT' },
];

const fields = [
  { id: 'aov', label: 'Average order value', hint: 'What a customer pays you, before any discount', value: 4000, prefix: 'Rs' },
  { id: 'cogs', label: 'Product cost', hint: 'What the products in one order cost you', value: 1600, prefix: 'Rs' },
  { id: 'ship', label: 'Delivery + COD charges', hint: 'Courier fee and cash-on-delivery charge per order', value: 400, prefix: 'Rs' },
  { id: 'fees', label: 'Returns + other fees', hint: 'Average cost of returns, payment and packaging per order', value: 560, prefix: 'Rs' },
  { id: 'disc', label: 'Discount', hint: 'Leave at 0 if you sell at full price', value: 0, suffix: '%' },
  { id: 'roas', label: 'Your current ROAS', hint: 'From Ads Manager: revenue ÷ ad spend', value: 4, suffix: 'x', step: 0.1 },
];

const jsonLd = graph(
  {
    '@type': 'WebApplication',
    name: 'Break-even ROAS calculator',
    url: absolute('/break-even-roas', Astro.site),
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'PKR' },
    publisher: { '@id': absolute('/#business', Astro.site) },
  },
  breadcrumbSchema(Astro.site, [{ name: 'Home', path: '/' }, { name: 'Break-even ROAS calculator', path: '/break-even-roas' }]),
);
---
<Base title="Break-even ROAS Calculator (PKR) | RastgarX" description="Free break-even ROAS calculator for Pakistani ecommerce brands. Enter your order value, product cost, delivery, COD and returns to see the ROAS you need to make a profit.">
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <div id="top" class="page">
    <div class="wrap">
      <Header links={links} homeHref="/" bookHref="/contact" />
      <div class="rule"></div>

      <main>
        <section class="animated-web">
          <div class="animated-web-head">
            <div>
              <p class="eyebrow">(Free tool)</p>
              <h1 class="display">Break-even ROAS<span class="dot">.</span></h1>
            </div>
            <p class="lede">A 4x ROAS can still lose money. Enter your real costs per order and see the ROAS you need just to break even, and what you actually keep from every sale.</p>
          </div>

          <div class="be" data-be>
            <form class="be-inputs" aria-label="Your numbers per order" onsubmit="return false">
              {fields.map((f) => (
                <label class="be-field">
                  <span class="be-label">{f.label}</span>
                  <span class="be-input">
                    {f.prefix && <span class="be-unit">{f.prefix}</span>}
                    <input id={f.id} name={f.id} type="number" inputmode="decimal" min="0" step={f.step ?? 'any'} value={f.value} />
                    {f.suffix && <span class="be-unit">{f.suffix}</span>}
                  </span>
                  <span class="be-hint">{f.hint}</span>
                </label>
              ))}
            </form>

            <div class="be-out" aria-live="polite">
              <div class="be-hero">
                <span class="be-k">Your break-even ROAS</span>
                <span class="be-big" data-out="be">2.8x</span>
                <span class="be-sub" data-out="formula">1 ÷ 36% margin</span>
              </div>

              <div class="be-scale" aria-hidden="true">
                <div class="be-track">
                  <div class="be-zone be-loss" data-zone="loss"></div>
                  <div class="be-zone be-win" data-zone="win"></div>
                  <div class="be-mark" data-mark="be"><span>BREAK-EVEN</span></div>
                  <div class="be-pin" data-mark="you"><span>YOU</span></div>
                </div>
                <div class="be-ticks"><span>0x</span><span>2x</span><span>4x</span><span>6x</span><span>8x</span><span>10x</span></div>
              </div>

              <div class="be-verdict" data-out="verdict"></div>

              <dl class="be-stats">
                <div><dt>Margin before ads</dt><dd data-out="margin">Rs 1,440 · 36%</dd></div>
                <div><dt>Max ad cost per order</dt><dd data-out="cpa">Rs 1,440</dd></div>
                <div><dt>Ad cost per order at your ROAS</dt><dd data-out="spend">Rs 1,000</dd></div>
                <div><dt>You keep per order</dt><dd data-out="profit">Rs 440</dd></div>
              </dl>

              <div class="be-bar" aria-hidden="true" data-bar></div>
              <div class="be-legend" aria-hidden="true">
                <span><i class="c-cost"></i>Costs</span><span><i class="c-ads"></i>Ads</span><span><i class="c-keep"></i>You keep</span><span><i class="c-lose"></i>Loss</span>
              </div>
            </div>
          </div>

          <div class="mk-block be-how">
            <h2 class="mk-h2">How it works<span class="dot">.</span></h2>
            <div class="be-how-grid">
              <p><b>Margin before ads</b> is what is left from an order after product, delivery, COD, returns and fees. Discounts shrink it fast, because your costs stay the same while the price drops.</p>
              <p><b>Break-even ROAS = 1 ÷ margin.</b> At a 36% margin you need 2.8x just to cover ads. Below that, every sale loses money, no matter how good the ROAS looks in Ads Manager.</p>
              <p><b>What to do with it.</b> If your ROAS sits near break-even, work on the order itself: raise the order value, cut return rates and fix the store. Each of those lowers the ROAS you need.</p>
            </div>
          </div>

          <div class="careers-open">
            <h2 class="mk-h2">Running ads below break-even<span class="dot">?</span></h2>
            <p class="lede muted">We find where the money leaks out of your ads, your store and your follow-up, and fix it before you spend more.</p>
            <a class="cta" href="/contact">GET A FREE PROFIT CHECK <Arrow /></a>
          </div>
        </section>
      </main>
    </div>
    <FooterCompact />
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-be]');
  if (root) {
    const num = (id: string) => {
      const v = parseFloat((root.querySelector<HTMLInputElement>('#' + id)?.value ?? '').replace(/,/g, ''));
      return Number.isFinite(v) && v > 0 ? v : 0;
    };
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const rs = (v: number) => `${v < -0.5 ? '−' : ''}Rs ${Math.abs(Math.round(v)).toLocaleString('en-US')}`;
    const pct = (v: number) => `${v < 0 ? '−' : ''}${Math.abs(Math.round(v * 100))}%`;
    const MAX = 10; // the scale runs 0x to 10x
    const pos = (x: number) => `${Math.max(0, Math.min(1, x / MAX)) * 100}%`;

    const update = () => {
      const price = num('aov') * (1 - Math.min(num('disc'), 100) / 100);
      const costs = num('cogs') + num('ship') + num('fees');
      const roas = num('roas');
      const contrib = price - costs;
      const margin = price > 0 ? contrib / price : 0;
      const be = margin > 0 ? 1 / margin : Infinity;
      const spend = roas > 0 ? price / roas : 0;
      const profit = contrib - spend;

      out('be').textContent = margin > 0 ? `${be.toFixed(1)}x` : 'No ROAS';
      out('be').classList.toggle('is-bad', !(margin > 0));
      out('formula').textContent = margin > 0 ? `1 ÷ ${pct(margin)} margin` : 'Your costs are higher than your price.';
      out('margin').textContent = `${rs(contrib)} · ${price > 0 ? pct(margin) : '0%'}`;
      out('cpa').textContent = rs(Math.max(0, contrib));
      out('spend').textContent = roas > 0 ? rs(spend) : '—';
      out('profit').textContent = roas > 0 ? rs(profit) : '—';
      out('profit').classList.toggle('is-bad', roas > 0 && profit < 0);
      out('profit').classList.toggle('is-good', roas > 0 && profit >= 0);

      const v = out('verdict');
      if (!(price > 0)) { v.textContent = 'Enter your order value to start.'; v.className = 'be-verdict'; }
      else if (!(margin > 0)) { v.textContent = 'Every order already loses money with zero ad spend. Raise your price or cut your costs.'; v.className = 'be-verdict is-bad'; }
      else if (!(roas > 0)) { v.textContent = `Your ads need at least ${be.toFixed(1)}x ROAS to break even.`; v.className = 'be-verdict'; }
      else if (profit >= 0) { v.textContent = `${roas.toFixed(1)}x clears your ${be.toFixed(1)}x break-even. You keep ${rs(profit)} per order.`; v.className = 'be-verdict is-good'; }
      else { v.textContent = `${roas.toFixed(1)}x is below your ${be.toFixed(1)}x break-even. You lose ${rs(-profit).replace('−', '')} on every order.`; v.className = 'be-verdict is-bad'; }

      // scale
      const beX = margin > 0 ? be : MAX;
      (root.querySelector('[data-zone="loss"]') as HTMLElement).style.width = pos(beX);
      (root.querySelector('[data-zone="win"]') as HTMLElement).style.left = pos(beX);
      const mk = root.querySelector('[data-mark="be"]') as HTMLElement;
      mk.style.left = pos(beX); mk.hidden = !(margin > 0);
      const pin = root.querySelector('[data-mark="you"]') as HTMLElement;
      pin.style.left = pos(roas); pin.hidden = !(roas > 0);
      pin.classList.toggle('is-bad', profit < 0);

      // where the order's money goes
      const bar = root.querySelector('[data-bar]') as HTMLElement;
      const parts: [string, number, string][] = [
        ['c-cost', Math.min(costs, price), 'Costs'],
        ['c-ads', roas > 0 ? Math.min(spend, Math.max(0, contrib)) : 0, 'Ads'],
        ['c-keep', Math.max(0, profit), 'You keep'],
      ];
      const loss = Math.max(0, costs + (roas > 0 ? spend : 0) - price);
      const total = Math.max(price, costs + (roas > 0 ? spend : 0));
      bar.innerHTML = total > 0
        ? [...parts, ['c-lose', loss, 'Loss'] as [string, number, string]]
            .filter(([, x]) => x > 0)
            .map(([c, x, l]) => `<span class="${c}" style="flex:${x}" title="${l}: ${rs(x)}"></span>`).join('')
        : '';
    };
    root.addEventListener('input', update);
    update();
  }
</script>

<style>
  .be { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 20px; align-items: start; }
  .be-inputs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 28px; padding: 28px; background: var(--bg-deep); border-radius: 16px; }
  .be-field { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .be-label { font-size: 17px; color: var(--ink-strong); }
  .be-hint { font-size: 14px; color: var(--dim); line-height: 1.35; }
  .be-input { display: flex; align-items: baseline; gap: 8px; border-bottom: 1px solid var(--line); padding-bottom: 8px; transition: border-color .2s; }
  .be-input:focus-within { border-bottom-color: var(--accent); }
  .be-unit { font-size: 18px; color: var(--muted); flex: none; }
  .be-input input {
    width: 100%; min-width: 0; background: transparent; border: 0; outline: 0; padding: 0;
    color: var(--ink-strong); font: 400 28px/1.1 var(--font); letter-spacing: -0.02em; -moz-appearance: textfield;
  }
  .be-input input::-webkit-outer-spin-button, .be-input input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }

  .be-out { position: sticky; top: 100px; display: flex; flex-direction: column; gap: 28px; padding: 28px; background: var(--surface); border-radius: 16px; }
  .be-hero { display: flex; flex-direction: column; gap: 6px; }
  .be-k { font-size: 17px; color: var(--muted); }
  .be-big { font-size: clamp(72px, 9vw, 140px); line-height: .9; font-weight: 900; letter-spacing: -0.05em; color: var(--accent); }
  .be-big.is-bad { color: #FF5A4F; font-size: clamp(48px, 6vw, 88px); }
  .be-sub { font-size: 17px; color: var(--muted); }

  .be-scale { padding-top: 26px; }
  .be-track { position: relative; height: 18px; border-radius: 999px; background: var(--bg-deep); }
  .be-zone { position: absolute; top: 0; bottom: 0; transition: left .35s, width .35s; }
  .be-loss { left: 0; background: rgba(255, 90, 79, .35); border-radius: 999px 0 0 999px; }
  .be-win { right: 0; background: rgba(31, 255, 0, .3); border-radius: 0 999px 999px 0; }
  .be-mark { position: absolute; top: -10px; bottom: -10px; width: 3px; margin-left: -1.5px; background: var(--ink-strong); transition: left .35s; }
  .be-mark span { position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 4px; font-size: 11px; font-weight: 500; letter-spacing: .08em; white-space: nowrap; color: var(--ink-strong); }
  .be-pin { position: absolute; top: 100%; width: 0; transition: left .35s; }
  .be-pin::before { content: ''; position: absolute; left: -8px; top: 4px; border: 8px solid transparent; border-bottom: 10px solid var(--accent); border-top: 0; }
  .be-pin span { position: absolute; top: 16px; left: 50%; transform: translateX(-50%); font-size: 11px; font-weight: 500; letter-spacing: .08em; color: var(--accent); }
  .be-pin.is-bad::before { border-bottom-color: #FF5A4F; }
  .be-pin.is-bad span { color: #FF5A4F; }
  .be-pin[hidden], .be-mark[hidden] { display: none; }
  .be-ticks { display: flex; justify-content: space-between; margin-top: 36px; font-size: 13px; color: var(--dim); }

  .be-verdict { font-size: 22px; line-height: 1.3; letter-spacing: -0.01em; color: var(--ink-strong); }
  .be-verdict.is-good { color: var(--accent); }
  .be-verdict.is-bad { color: #FF5A4F; }

  .be-stats { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; border-top: 1px solid var(--line); padding-top: 22px; }
  .be-stats div { display: flex; flex-direction: column; gap: 4px; }
  .be-stats dt { font-size: 14px; color: var(--muted); }
  .be-stats dd { margin: 0; font-size: 26px; letter-spacing: -0.03em; color: var(--ink-strong); }
  .be-stats dd.is-good { color: var(--accent); }
  .be-stats dd.is-bad { color: #FF5A4F; }

  .be-bar { display: flex; height: 14px; border-radius: 999px; overflow: hidden; gap: 2px; background: var(--bg-deep); }
  .be-bar :global(span) { transition: flex .35s; }
  .be-legend { display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 13px; color: var(--muted); margin-top: -16px; }
  .be-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .be-legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
  .be :global(.c-cost) { background: #6A6A6E; }
  .be :global(.c-ads) { background: #A8A8AC; }
  .be :global(.c-keep) { background: var(--accent); }
  .be :global(.c-lose) { background: #FF5A4F; }

  .be-how-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 40px; }
  .be-how-grid p { font-size: 17px; line-height: 1.5; color: var(--muted); }
  .be-how-grid b { color: var(--ink-strong); font-weight: 500; }
  .careers-open { align-items: flex-start; }
  /* .careers-open a (global) turns links green and underlined; keep the button dark-on-green */
  .careers-open .cta, .careers-open .cta:hover { color: var(--on-accent); text-decoration: none; }

  @media (max-width: 1000px) {
    .be { grid-template-columns: minmax(0, 1fr); }
    .be-out { position: static; }
    .be-how-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 560px) {
    .be-inputs { grid-template-columns: minmax(0, 1fr); padding: 22px 20px; gap: 24px; }
    .be-out { padding: 22px 20px; }
    .be-stats dd { font-size: 22px; }
    .be-verdict { font-size: 20px; }
  }
</style>
