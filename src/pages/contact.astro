---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import FooterCompact from '../components/FooterCompact.astro';
import Arrow from '../components/Arrow.astro';
import { site, mailHref, telHref } from '../data/site';

const links = [
  { href: '/#work', label: 'WORK' },
  { href: '/#solution', label: 'STUDIO' },
  { href: '/careers', label: 'CAREERS' },
  { href: '/break-even-roas', label: 'ROAS TOOL' },
  { href: '/contact', label: 'CONTACT', current: true },
];

---
<Base title="Contact RastgarX | Growth Partner in Islamabad, Pakistan" description="Contact RastgarX in Islamabad by WhatsApp, phone or email. We reply within one working day with a plan for your website, performance marketing and automations.">
  <div id="top" class="page">
    <div class="wrap">
      <Header links={links} homeHref="/" bookHref="#direct" />
      <div class="rule"></div>

      <main>
        <section class="info contact-intro">
          <div class="info-cols">
            <div class="info-col">
              <span>Studio</span>
              <span><span class="accent">&gt;</span> {site.city}, {site.country}</span>
            </div>
            <div class="info-col">
              <span>Response time</span>
              <span><span class="accent">&gt;</span> Within 1 working day</span>
            </div>
            <div class="info-col">
              <span class="intake"><span class="led" aria-hidden="true"></span>{site.openSlots} of 5 slots open</span>
            </div>
          </div>
          <p class="lede contact-pitch">Call, WhatsApp or email us with your business name and what you want to grow. We reply within one working day with where to start.</p>
        </section>

        <section class="contact-head">
          <p class="eyebrow">(Get in touch)</p>
          <h1 class="display">Let’s grow your revenue<span class="dot">.</span></h1>
        </section>

        <section class="contact-direct" id="direct">
          <p class="eyebrow">(Reach us directly)</p>
          <div class="contact-direct-row">
            <a class="contact-direct-link" href={mailHref}><span class="muted">Email</span><span>{site.email}</span><Arrow /></a>
            <a class="contact-direct-link" href={telHref}><span class="muted">Phone / WhatsApp</span><span>{site.phone}</span><Arrow /></a>
          </div>
        </section>
      </main>
    </div>
    <FooterCompact />
  </div>
</Base>

