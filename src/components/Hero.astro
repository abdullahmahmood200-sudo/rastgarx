---
import { site } from '../data/site';
const isVideo = !!site.hero && /\.(mp4|webm)$/i.test(site.hero);
---
<section class="hero-head">
  <h1 class="display">Plug the leaks.<br />Then scale<span class="dot">.</span></h1>
</section>

<div class="hero-media">
  {site.hero && (isVideo
    ? <video src={site.hero} autoplay muted loop playsinline aria-label={site.heroAlt}></video>
    : <img src={site.hero} alt={site.heroAlt} width="1916" height="821" fetchpriority="high" />)}
</div>
