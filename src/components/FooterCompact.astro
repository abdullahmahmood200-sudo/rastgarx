---
import Logo from './Logo.astro';
import FooterCities from './FooterCities.astro';
import FooterAccordion from './FooterAccordion.astro';
import { site, telHref, mailHref } from '../data/site';
const year = new Date().getFullYear();
---
<footer id="contact" class="footer footer-compact">
  <div class="footer-brand" aria-hidden="true">
    <Logo size="100%" />
    <span class="footer-word">RASTUP<span class="dot">.</span></span>
  </div>
  <div class="footer-compact-row">
    <div class="stack"><span class="footer-label">CONTACT</span><a href={mailHref}>{site.email}</a><a href={telHref}>{site.phone}</a></div>
    <div class="stack"><span class="footer-label">STUDIO</span><span>{site.city}, {site.country}</span></div>
    <p class="footer-motto">We build.<br /><span class="accent">You profit.</span></p>
  </div>
  <FooterCities />
  <FooterAccordion />
  <div class="footer-bottom">
    <span>© {year} {site.name}</span>
    <span class="footer-legal"><a href="/locations">Locations</a><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="#top">Back to top ↑</a></span>
  </div>
</footer>
