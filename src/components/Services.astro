---
// One card per leak, in the order a customer meets them.
const services = [
  {
    leak: 'Fixes leak 01',
    title: ['Marketing'],
    body: 'Reels, ads and SEO that stop the scroll and bring in people who are ready to buy, not just people who like the post.',
    points: ['Reels & video ads', 'Ad creatives & campaigns', 'SEO & Google Maps', 'Brand identity'],
    link: { href: '/marketing', label: 'VIEW OUR WORK' },
  },
  {
    leak: 'Fixes leak 02',
    title: ['Websites'],
    body: 'Fast, animated websites and online stores built around one action, so paid visitors become enquiries instead of bouncing.',
    points: ['Custom design & brand kit', 'Animations & interactions', 'E-commerce stores', 'Mobile-first & fast-loading'],
    link: { href: '/animated-web-development', label: 'VIEW OUR WORK' },
    green: true,
  },
  {
    leak: 'Fixes leak 03',
    title: ['Automations'],
    body: 'AI voice and WhatsApp agents plus workflows that answer every enquiry in seconds and follow up until it books.',
    points: ['AI voice operator, day and night', 'WhatsApp AI agent', 'Automated lead follow-up', 'Bookings into your calendar'],
    link: { href: '/automations', label: 'VIEW OUR WORK' },
  },
];
---
<section id="work" class="services center-section">
  <span class="tag">ONE TEAM. THE WHOLE SYSTEM.</span>
  <h2 class="h-center">Three leaks. One team.<br /><span class="muted">Judged by one number: customers.</span></h2>
  <div class="cards">
    {services.map((s) => (
      <article class:list={['card', 'lift', { 'is-green': s.green }]}>
        <span>({s.leak})</span>
        <h3>{s.title.map((line, j) => <>{j > 0 && <br />}{line}</>)}</h3>
        <p class="body">{s.body}</p>
        <ul>{s.points.map((p) => <li>{p}</li>)}</ul>
        <a class="card-link" href={s.link.href}>{s.link.label}</a>
      </article>
    ))}
  </div>
</section>
