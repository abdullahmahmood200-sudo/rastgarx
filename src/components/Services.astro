---
const services = [
  {
    title: ['Websites'],
    body: 'Animated, high-performance websites and online stores engineered to turn visitors into customers.',
    points: ['Custom design & brand kit', 'Animations & interactions', 'E-commerce stores', 'Mobile-first & fast-loading'],
    link: { href: '/animated-web-development', label: 'VIEW OUR WORK' },
    green: true,
  },
  {
    title: ['Marketing'],
    body: 'Ad campaigns, social creatives and SEO that put your business in front of the right customers.',
    points: ['Ad creatives & campaigns', 'Posters, billboards & social', 'SEO & Google Maps', 'Built to stop the scroll'],
    link: { href: '/work', label: 'VIEW OUR WORK' },
  },
  {
    title: ['Automations'],
    body: 'AI voice operators and automated workflows that answer every call, book customers in and keep leads from slipping away.',
    points: ['AI voice operator, day and night', 'Books straight into your calendar', 'Automated lead follow-up', 'Knows when to hand over'],
    link: { href: '/automations', label: 'VIEW OUR WORK' },
  },
];
---
<section id="work" class="services center-section">
  <span class="tag">WHAT WE BUILD</span>
  <h2 class="h-center">One system. Three moving parts.<br /><span class="muted">Built to run as one.</span></h2>
  <div class="cards">
    {services.map((s, i) => (
      <article class:list={['card', 'lift', { 'is-green': s.green }]}>
        <span>({String(i + 1).padStart(2, '0')})</span>
        <h3>{s.title.map((line, j) => <>{j > 0 && <br />}{line}</>)}</h3>
        <p class="body">{s.body}</p>
        <ul>{s.points.map((p) => <li>{p}</li>)}</ul>
        <a class="card-link" href={s.link.href}>{s.link.label}</a>
      </article>
    ))}
  </div>
</section>
