---
// The three leaks: where customers are lost, in the order a buyer meets them.
const leaks = [
  { stage: 'Before the click', title: 'Ads people scroll past', body: 'Creative that looks like everyone else’s gets ignored. You pay to be seen, and nobody stops.' },
  { stage: 'After the click', title: 'A site that lets them go', body: 'A slow or confusing page sends paid visitors back to Google, often straight to a competitor.' },
  { stage: 'After the enquiry', title: 'Enquiries nobody answers', body: 'A call at 9pm, a WhatsApp at lunch. If nobody replies fast, the customer books whoever did.' },
];
---
<section id="problem" class="problem">
  <div class="problem-head">
    <div>
      <span class="tag">WHY MORE ADS NEVER FIXED IT</span>
      <h2 class="h-section">You paid for clicks.<br />You needed customers<span class="dot">.</span></h2>
    </div>
    <p class="lede muted">Spend goes up, the reports look busier, and the bank balance barely moves. The money isn’t lost in the ads. It leaks out in three places most agencies never look.</p>
  </div>
  <div class="grid-3">
    {leaks.map((l, i) => (
      <div class="pain">
        <span class="accent" style="font-size: 17px">(Leak {String(i + 1).padStart(2, '0')}) {l.stage}</span>
        <h3>{l.title}</h3>
        <p class="body muted">{l.body}</p>
      </div>
    ))}
  </div>
  <p class="lede problem-note">Most agencies fix one of these. Customers are lost in all three<span class="dot">.</span></p>
</section>
