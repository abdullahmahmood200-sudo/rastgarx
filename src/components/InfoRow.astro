---
import { site } from '../data/site';

// Rendered at build time so the page never shows an empty clock;
// the script below keeps it live in the browser.
const now = new Date();
const tz = site.timeZone;
const time = now.toLocaleTimeString('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).replace(' ', '').toLowerCase();
const weekday = now.toLocaleDateString('en-US', { timeZone: tz, weekday: 'long' });
const date = now.toLocaleDateString('en-US', { timeZone: tz, month: 'long', day: '2-digit', year: 'numeric' });
---
<section class="info" data-clock data-tz={tz}>
  <div class="info-cols">
    <div class="info-col">
      <span>{site.city}, {site.country}</span>
      <span class="info-time">Local time
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1FFF00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg>
        <time data-time>{time}</time></span>    </div>
    <div class="info-col">
      <span data-weekday>{weekday}</span>
      <span data-date>{date}</span>
    </div>
    <div class="info-col">
      <span class="intake"><span class="led" aria-hidden="true"></span>Closing intake soon</span>
    </div>
  </div>
  <div class="info-pitch">
    <div class="tags">
      <span class="tag-soft">Strategy</span>
      <span class="tag-soft">Automation</span>
      <span class="tag-soft">Enablement</span>
    </div>
    <p class="lede">A website that actually converts and ads that actually bring people in, so you stop losing customers to a slow site and empty ad spend.</p>
    <a class="cta" href="#book">BOOK A FREE CALL</a>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-clock]');
  if (root) {
    const tz = root.dataset.tz || 'Asia/Karachi';
    const q = (s: string) => root.querySelector<HTMLElement>(s);
    const tick = () => {
      const d = new Date();
      try {
        q('[data-time]')!.textContent = d.toLocaleTimeString('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).replace(' ', '').toLowerCase();
        q('[data-weekday]')!.textContent = d.toLocaleDateString('en-US', { timeZone: tz, weekday: 'long' });
        q('[data-date]')!.textContent = d.toLocaleDateString('en-US', { timeZone: tz, month: 'long', day: '2-digit', year: 'numeric' });
      } catch {}
    };
    tick();
    setInterval(tick, 15000);
  }
</script>
