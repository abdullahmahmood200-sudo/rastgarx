---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import FooterAccordion from './FooterAccordion.astro';
import { site, telHref, mailHref } from '../data/site';

const year = new Date().getFullYear();
---
<footer id="contact" class="footer">
  <div class="footer-brand" aria-hidden="true">
    <Logo size="100%" />
    <span class="footer-word">RASTGARX<span class="dot">.</span></span>
  </div>
  <div class="footer-cols">
    <div class="footer-about">
      <span class="footer-label">ABOUT</span>
      <p>RastgarX is a growth partner: we build websites, run marketing and set up automations as one system, serving businesses nationwide.</p>
      <p class="footer-motto">We build.<br /><span class="accent">You profit.</span></p>
    </div>
    <div class="footer-grid">
      <div>
        <span class="footer-label">STUDIO</span>
        <span>{site.city}<br />{site.country}</span>
      </div>
      <div>
        <span class="footer-label">CONTACT</span>
        <span class="stack"><a href={mailHref}>{site.email}</a><a href={telHref}>{site.phone}</a></span>
      </div>
      <div>
        <span class="footer-label">EXPLORE</span>
        <span class="stack">
          <a href="/#work">Services</a>
          <a href="/work">Our Work</a>
          <a href="/marketing">Marketing</a>
          <a href="/automations">Automations</a>
          <a href="/blog">Blog</a>
          <a href="/contact">Contact</a>
          <a href="/locations">Locations</a>
        </span>
      </div>
      <div>
        <span class="footer-label">LEGAL</span>
        <span class="stack"><a href="/privacy">Privacy Policy</a><a href="/terms">Terms of Service</a></span>
      </div>
      <div>
        <span class="footer-label">GET STARTED</span>
        <a class="footer-cta" href="/contact">Book a free call <Arrow /></a>
      </div>
    </div>
  </div>
  <FooterAccordion />
  <div class="footer-bottom">
    <span>© {year} {site.name}<span class="footer-bottom-extra"> · {site.city}, {site.country} · {site.phone} · {site.email}</span></span>
    <a href="#top">Back to top ↑</a>
  </div>
</footer>
