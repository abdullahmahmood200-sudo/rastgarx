---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';

interface Link { href: string; label: string; current?: boolean }
interface Props { links?: Link[]; homeHref?: string; bookHref?: string }

const {
  links = [
    { href: '#problem', label: 'PROBLEM' },
    { href: '#solution', label: 'SOLUTION' },
    { href: '#work', label: 'THE WORK' },
    { href: '/contact', label: 'CONTACT' },
  ],
  homeHref = '#top',
  bookHref = '#book',
} = Astro.props;
---
<header class="header" data-header>
  <a class="brand" href={homeHref} aria-label="RastgarX home">
    <Logo />
    <span class="brand-word">RASTGARX<span class="dot">.</span></span>
  </a>
  <div class="header-right">
    <nav class="nav" id="main-nav" aria-label="Main">
      {links.map((l) => <a href={l.href} class:list={{ 'is-current': l.current }} aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <button class="menu-btn" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Open menu" data-menu-btn>
      <svg class="i-open" aria-hidden="true" width="28" height="20" viewBox="0 0 28 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M0 1h28M0 10h28M0 19h28"></path></svg>
      <svg class="i-close" aria-hidden="true" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l20 20M21 1L1 21"></path></svg>
    </button>
    <a class="round" href={bookHref} aria-label="Book a free call"><Arrow size={20} stroke={2.2} /></a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = header?.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const root = document.documentElement;

  /* ---------- Top bar: fixed, hides on scroll down, returns on scroll up ----------
     The header sits inside the smooth-scroll content, which is transformed,
     so it is moved into a fixed, see-through shell at body level, and a
     spacer keeps its place in the page (the divider line stays in the page). */
  const mq = window.matchMedia('(max-width: 900px)');   // phone menu
  const shell = document.createElement('div');
  shell.className = 'header-shell';
  const spacer = document.createElement('div');
  spacer.className = 'header-spacer';
  spacer.setAttribute('aria-hidden', 'true');
  if (header) {
    header.before(spacer);
    shell.append(header);
    document.body.prepend(shell);

    // Spacer = bar height minus the page's own top padding, kept in sync on resize.
    const size = () => {
      if (shell.classList.contains('is-open')) return;
      const pad = parseFloat(getComputedStyle(spacer.parentElement!).paddingTop) || 0;
      spacer.style.height = Math.max(0, shell.offsetHeight - pad) + 'px';
    };
    size();
    new ResizeObserver(size).observe(shell);
  }

  // Hide after a deliberate scroll down, show after a deliberate scroll up,
  // so small wobbles never make the bar twitch.
  let lastY = window.scrollY;
  let travel = 0;            // distance moved in the current direction
  let ticking = false;
  const onScroll = () => {
    ticking = false;
    const y = Math.max(0, window.scrollY);
    const dy = y - lastY;
    lastY = y;
    shell.classList.toggle('is-scrolled', y > 0);
    if (header?.classList.contains('is-open')) return;
    if (y <= shell.offsetHeight) { shell.classList.remove('is-hidden'); travel = 0; return; }
    if (dy === 0) return;
    travel = Math.sign(dy) === Math.sign(travel) ? travel + dy : dy;
    if (travel > 24) shell.classList.add('is-hidden');           // scrolling down
    else if (travel < -12) shell.classList.remove('is-hidden');  // scrolling up
  };
  window.addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
  }, { passive: true });

  if (header && btn) {
    const set = (open: boolean) => {
      header.classList.toggle('is-open', open);
      shell.classList.toggle('is-open', open);
      root.classList.toggle('menu-open', open && mq.matches);
      if (open) shell.classList.remove('is-hidden');
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };
    btn.addEventListener('click', () => set(!header.classList.contains('is-open')));
    header.querySelectorAll('.nav a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) set(false);
    });
    mq.addEventListener('change', () => set(false));
  }
</script>
