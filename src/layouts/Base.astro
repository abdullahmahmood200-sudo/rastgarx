---
import '../styles/global.css';
import { site } from '../data/site';
import Logo from '../components/Logo.astro';

interface Props { title?: string; description?: string }
const { title = site.title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1C1C1E" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Satoshi-Light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <slot name="head" />
    <!-- Arriving from a page transition: keep the overlay up from the first paint. -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('rastup-pt') && !matchMedia('(prefers-reduced-motion: reduce)').matches)
          document.documentElement.classList.add('pt-in');
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Fixed-position things live outside the smooth-scroll wrapper. -->
    <div class="cursor-dot" aria-hidden="true"></div>

    <!-- Page transition: the destination's name decodes over a dark screen. -->
    <div class="pt" aria-hidden="true" data-pt>
      <div class="pt-inner">
        <Logo size={44} />
        <span class="pt-word" data-pt-word></span>
        <span class="pt-route" data-pt-route></span>
      </div>
    </div>
    <script is:inline>
      try {
        var pt = JSON.parse(sessionStorage.getItem('rastup-pt') || 'null');
        if (pt) {
          document.querySelector('[data-pt-word]').textContent = pt.word;
          document.querySelector('[data-pt-route]').textContent = pt.route;
        }
      } catch (e) {}
    </script>

    <div id="smooth-wrapper">
      <div id="smooth-content">
        <slot />
      </div>
    </div>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { ScrollSmoother } from 'gsap/ScrollSmoother';

      gsap.registerPlugin(ScrollTrigger, ScrollSmoother);

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      /* ---------- Smooth scroll ---------- */
      let smoother: ScrollSmoother | null = null;
      if (!reduceMotion) {
        smoother = ScrollSmoother.create({
          wrapper: '#smooth-wrapper',
          content: '#smooth-content',
          smooth: 1.1,          // seconds to "catch up", higher is floatier
          effects: true,        // enables data-speed / data-lag attributes
          smoothTouch: false,   // native scrolling on phones and tablets
          normalizeScroll: false,
        });
        document.documentElement.classList.add('has-smoother');

        // In-page links (#book, /#solution from the same page, Back to top).
        const toTarget = (hash: string) => {
          const el = hash === '#top' ? document.body : document.querySelector(hash);
          if (!el || !smoother) return false;
          smoother.scrollTo(el, true, 'top top');
          history.replaceState(null, '', hash === '#top' ? location.pathname : hash);
          return true;
        };
        document.addEventListener('click', (e) => {
          const a = (e.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
          if (!a || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
          const url = new URL(a.href, location.href);
          if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) return;
          if (toTarget(url.hash)) e.preventDefault();
        });

        // Arriving with a hash (e.g. /#book from the Work page).
        if (location.hash) {
          window.addEventListener('load', () => {
            const el = document.querySelector(location.hash);
            if (el) smoother!.scrollTo(el, false, 'top top');
          });
        }

        // Keep scroll length right when content height changes (List/Grid toggle, images).
        let t: number | undefined;
        new ResizeObserver(() => {
          clearTimeout(t);
          t = window.setTimeout(() => ScrollTrigger.refresh(), 120);
        }).observe(document.getElementById('smooth-content')!);
      }

      /* ---------- Dot cursor (mouse/trackpad only) ---------- */
      const dot = document.querySelector<HTMLElement>('.cursor-dot');
      if (dot && finePointer) {
        document.documentElement.classList.add('has-dot-cursor');
        gsap.set(dot, { xPercent: -50, yPercent: -50 });
        const dur = reduceMotion ? 0 : 0.18;
        const moveX = gsap.quickTo(dot, 'x', { duration: dur, ease: 'power3.out' });
        const moveY = gsap.quickTo(dot, 'y', { duration: dur, ease: 'power3.out' });

        let shown = false;
        window.addEventListener('pointermove', (e) => {
          if (e.pointerType !== 'mouse') return;
          if (!shown) { gsap.set(dot, { x: e.clientX, y: e.clientY }); dot.classList.add('is-visible'); shown = true; }
          moveX(e.clientX);
          moveY(e.clientY);
        }, { passive: true });
        document.addEventListener('mouseleave', () => { dot.classList.remove('is-visible'); shown = false; });

        // Grow over anything clickable.
        const interactive = 'a, button, [role="button"], label, summary, .work-row, .work-tile';
        document.addEventListener('pointerover', (e) => {
          if ((e.target as Element).closest?.(interactive)) dot.classList.add('is-hover');
        });
        document.addEventListener('pointerout', (e) => {
          const to = e.relatedTarget as Element | null;
          if (!to || !to.closest?.(interactive)) dot.classList.remove('is-hover');
        });
        window.addEventListener('pointerdown', () => dot.classList.add('is-down'));
        window.addEventListener('pointerup', () => dot.classList.remove('is-down'));
      }
    </script>

    <script>
      /* ---------- Page transition: text decode ---------- */
      const KEY = 'rastup-pt';
      const root = document.documentElement;
      const overlay = document.querySelector<HTMLElement>('[data-pt]');
      const wordEl = document.querySelector<HTMLElement>('[data-pt-word]');
      const routeEl = document.querySelector<HTMLElement>('[data-pt-route]');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const GLYPHS = '#%&@$01<>/\\=+*ABCDEFXYZ';

      // "/locations/rahim-yar-khan/" -> "RAHIM YAR KHAN", "/" -> "HOME"
      const labelFor = (path: string) => {
        const segs = path.split('/').filter(Boolean);
        if (!segs.length) return 'HOME';
        return decodeURIComponent(segs[segs.length - 1]).replace(/-/g, ' ').toUpperCase();
      };

      // Scramble the word, locking letters in from left to right.
      const decode = (el: HTMLElement, word: string, duration: number) => {
        const start = performance.now();
        const frame = (now: number) => {
          const p = Math.min(1, (now - start) / duration);
          const locked = Math.floor(p * word.length);
          let out = '';
          for (let i = 0; i < word.length; i++) {
            out += i < locked || word[i] === ' ' ? word[i] : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
          }
          el.textContent = out;
          if (p < 1) requestAnimationFrame(frame);
        };
        frame(start); // draw the first scrambled frame now, not a frame later
      };

      const store = (v: object | null) => {
        try { v ? sessionStorage.setItem(KEY, JSON.stringify(v)) : sessionStorage.removeItem(KEY); } catch {}
      };

      // Arriving: the overlay is already showing the resolved name. Reveal the page.
      if (root.classList.contains('pt-in')) {
        store(null);
        setTimeout(() => root.classList.remove('pt-in'), 160);
      } else {
        store(null);
      }

      // Leaving: intercept links to other pages on this site.
      if (overlay && wordEl && routeEl && !reduce) {
        document.addEventListener('click', (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const a = (e.target as Element).closest?.('a[href]') as HTMLAnchorElement | null;
          if (!a || a.hasAttribute('download') || (a.target && a.target !== '_self')) return;
          const url = new URL(a.href, location.href);
          if (url.origin !== location.origin) return;
          if (url.pathname === location.pathname) return;            // same page (hash links)
          if (/\.[a-z0-9]+$/i.test(url.pathname)) return;            // files: sitemap.xml, llms.txt
          e.preventDefault();

          const word = labelFor(url.pathname);
          const route = url.pathname.replace(/\/$/, '') || '/';
          routeEl.textContent = route;
          wordEl.textContent = '';
          overlay.classList.add('is-on');
          decode(wordEl, word, 460);
          store({ word, route });
          setTimeout(() => { location.href = url.href; }, 540);
        });

        // Back/forward from the browser cache: never leave the overlay stuck on.
        window.addEventListener('pageshow', (e) => {
          if (e.persisted) { overlay.classList.remove('is-on'); root.classList.remove('pt-in'); store(null); }
        });
      }
    </script>
  </body>
</html>
